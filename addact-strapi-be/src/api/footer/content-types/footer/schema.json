{
  "kind": "collectionType",
  "collectionName": "footers",
  "info": {
    "singularName": "footer",
    "pluralName": "footers",
    "displayName": "Footer",
    "description": "Website Footer with multi-region office addresses and contact support"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "internalName": {
      "type": "string",
      "required": true
    },
    "region": {
      "type": "enumeration",
      "enum": [
        "global",
        "usa",
        "australia",
        "india",
        "uk"
      ],
      "default": "global",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "backgroundImageMobile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "addressInformation": {
      "type": "component",
      "component": "shared.office-address",
      "repeatable": true
    },
    "footerColumns": {
      "type": "component",
      "component": "shared.footer-column",
      "repeatable": true
    },
    "milestonesTitle": {
      "type": "string"
    },
    "milestonesImages": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "copyrightText": {
      "type": "string"
    },
    "siteSlogan": {
      "type": "string"
    },
    "socialMedia": {
      "type": "component",
      "component": "shared.link",
      "repeatable": true
    }
  }
}
