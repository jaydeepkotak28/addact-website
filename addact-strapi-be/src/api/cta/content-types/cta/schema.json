{
  "kind": "collectionType",
  "collectionName": "ctas",
  "info": {
    "singularName": "cta",
    "pluralName": "ctas",
    "displayName": "CTA"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "internalName": {
      "type": "string"
    },
    "title": {
      "type": "component",
      "component": "shared.title",
      "repeatable": false
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "link": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "default",
        "cta-logo",
        "cta-center"
      ],
      "default": "default"
    }
  }
}
