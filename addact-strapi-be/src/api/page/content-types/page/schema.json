{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Dynamic generic web pages with pageHeading component and dynamic zone sections"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "internalName": {
      "type": "string",
      "required": true
    },
    "pageType": {
      "type": "enumeration",
      "default": "Standard",
      "enum": [
        "Standard",
        "Dark",
        "Light",
        "LegalPolicy",
        "FullWidth"
      ]
    },
    "variant": {
      "type": "enumeration",
      "default": "default",
      "enum": [
        "default",
        "dark",
        "light",
        "legal_policy"
      ]
    },
    "pageHeading": {
      "type": "component",
      "component": "page-structure.page",
      "repeatable": false
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "content-relation.promo-relation",
        "content-relation.content-relation",
        "content-relation.banner-relation",
        "content-relation.cta-relation",
        "content-relation.capabilities-relation",
        "media-relation.video-relation",
        "ai.animation-banner"
      ]
    }
  }
}
